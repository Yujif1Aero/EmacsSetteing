##ref https://datawokagaku.com/terminal_prompt_git/
# Show staged/unstaged markers such as + and * in the prompt.
# For a slow repository, disable this per repo with:
#   git config bash.showDirtyState false
function join_by { local IFS="$1"; shift; echo "$*"; }

ColorReset='\[\e[0m\]'
ColorRed='\[\e[0;31m\]'
ColorGreen='\[\e[0;32m\]'

_PS1_GIT_USERS=$(join_by , $(git config --global --get-all user.name 2>/dev/null))
if [ "$_PS1_GIT_USERS" = 'Yuji,Sam,Shimojima' ]; then
    _PS1_GIT_USER_LABEL=$'\360\237\216\214'
elif [ -n "$_PS1_GIT_USERS" ]; then
    _PS1_GIT_USER_LABEL="$_PS1_GIT_USERS"
else
    _PS1_GIT_USER_LABEL="No Git User"
fi

git_prompt_script=
for script in \
    /usr/local/etc/bash_completion.d/git-prompt.sh \
    /usr/lib/git-core/git-sh-prompt \
    /etc/bash_completion.d/git-prompt
do
    if [ -s "$script" ]; then
        git_prompt_script=$script
        break
    fi
done

if [ -n "$git_prompt_script" ]; then
    source "$git_prompt_script"
    export GIT_PS1_SHOWDIRTYSTATE=true
    unset GIT_PS1_SHOWUNTRACKEDFILES
    unset GIT_PS1_SHOWSTASHSTATE
    export PS1='\[\e[0;31m\]\W\[\e[0;32m\] (${_PS1_GIT_USER_LABEL}$(__git_ps1 ":%s")) \[\e[0m\]:$ '
else
    export PS1="$ColorRed\W$ColorReset :$ "
fi
# Colors ls should use for folders, files, symlinks etc, see `man ls` and
# search for LSCOLORS
export LSCOLORS=ExGxFxdxCxDxDxaccxaeex

# Load git completions
git_completion_script=/usr/local/etc/bash_completion.d/git-completion.sh
test -s $git_completion_script && source $git_completion_script
# A more colorful prompt


# Share history across all open terminal tabs and windows
