# Git Username取得関数
function join_by { local IFS="$1"; shift; echo "$*"; }
function _ps1_git_username {
  local git_users_array=`git config --global --get-all user.name`
  git_users=`join_by , $git_users_array`
  test "$git_users" == 'Yuji,Sam,Shimojima' && echo "🍜" && return
  test "$git_users" && echo "$git_users" && return
  echo "No Git User"
}

# Nix Shell判定用関数 (色指定はここでは行わず、文字だけを出力します)
function nix_prompt {
  if [ -n "$IN_NIX_SHELL" ]; then
    echo -n "[nix: $name] "
  fi
}

# プロンプト(PS1)の構築
git_prompt_script=/usr/local/etc/bash_completion.d/git-prompt.sh
if [ -s $git_prompt_script ]; then
  source $git_prompt_script
  export GIT_PS1_SHOWDIRTYSTATE=true
  # nix_promptの前に明るい水色(\e[1;36m)を配置し、文字化けを防ぎます
  export PS1='\[\e[1;36m\]$(nix_prompt)\[\e[0;31m\]\W\[\e[0;32m\] ($(_ps1_git_username "(%s)")$(__git_ps1 ":%s")) \[\e[0m\]:$ '
else
  export PS1='\[\e[1;36m\]$(nix_prompt)\[\e[0;31m\]\W\[\e[0m\] :$ '
fi
